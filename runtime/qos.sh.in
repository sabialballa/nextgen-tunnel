#!/bin/bash
set -euo pipefail
ip link show @IFACE@ >/dev/null 2>&1 || exit 0
current=$(tc qdisc show dev @IFACE@)
if ! printf "%s\n" "$current" | grep -q "qdisc cake .*bandwidth @RATE@Mbit.*besteffort flows.*split-gso.*rtt @RTT@ms.*overhead @OVERHEAD@"; then
 tc qdisc replace dev @IFACE@ root cake bandwidth @RATE@mbit besteffort flows rtt @RTT@ms split-gso overhead @OVERHEAD@
fi
