[Unit]
Description=Nextgen authenticated site carrier engine
After=network-online.target nextgen-site.service
Wants=network-online.target
Requires=nextgen-site.service
PartOf=nextgen-site.service
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
User=nextgen-engine
LoadCredential=engine.json:/etc/nextgen-stack/engine.json
LoadCredential=redundancy.json:/etc/nextgen-stack/redundancy.json
TLS_CREDENTIALS
ExecStart=/usr/local/lib/nextgen-stack/nextgen-tunnel engine-run -binary /usr/local/lib/nextgen-stack/sing-box -sha256 ENGINE_SHA256 -config %d/engine.json -redundancy-config %d/redundancy.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LimitNOFILE=65536
TasksMax=128
MemoryMax=384M
UMask=0077

[Install]
WantedBy=multi-user.target
